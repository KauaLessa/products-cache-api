# Copy to .env and adjust the values:  cp .env.example .env
# The values below are for running the API directly on your machine (npm run dev)
# with Mongo and Redis started by Docker. Inside the local docker compose,
# compose.override.yaml switches the hosts to the service names (mongo/redis).

# ---------- App ----------
PORT=3000
NODE_ENV=development

# ---------- MongoDB ----------
# Local:  mongodb://localhost:27017/products
# AWS:    mongodb://USER:PASSWORD@EC2_PRIVATE_IP:27017/products?authSource=admin
MONGODB_URI=mongodb://localhost:27017/products
MONGODB_MAX_POOL_SIZE=20
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Used only by the Mongo container (compose.yaml) to create the root user.
# Leave both empty locally (no authentication). On AWS, fill in both.
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=

# ---------- Cache ----------
# none | cache-aside | write-through
CACHE_STRATEGY=none
CACHE_TTL_SECONDS=60
CACHE_KEY_PREFIX=products-api:
# Cache-aside: delete the key (DEL) after a write? false = wait for the TTL to expire.
CACHE_INVALIDATE_ON_WRITE=true

# ---------- Redis / ElastiCache ----------
# Local: localhost | AWS: ElastiCache primary endpoint, without the port
#   (e.g. master.tema10-cache.abc123.use1.cache.amazonaws.com). AWS setup: docs/deploy-aws.md
REDIS_HOST=localhost
REDIS_PORT=6379
# ElastiCache RBAC user and AUTH token (leave empty locally)
REDIS_USERNAME=
REDIS_PASSWORD=
# true if in-transit encryption is enabled on ElastiCache (the console default for new caches)
REDIS_TLS=false
# true for ElastiCache with cluster mode enabled or ElastiCache Serverless
REDIS_CLUSTER_MODE=false
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=1000
