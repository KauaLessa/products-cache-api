# Settings for loadtest/run.sh and loadtest/invalidation-demo.sh on the AWS load
# generator. Copy and fill in:  cp loadtest/aws.env.example loadtest/aws.env
# KEY=VALUE lines, no quotes. A variable on the command line wins over this file.

# Private IP of the API EC2
API_URL=http://10.0.x.x:3000
# ElastiCache primary endpoint; rediss:// = TLS (in-transit encryption on)
REDIS_URL=rediss://master.tema10-cache.abc123.use1.cache.amazonaws.com:6379
# Must match the seed count (seed.js --count)
PRODUCTS=100000
DURATION=60s
WARMUP_SECONDS=10
# Results folder inside loadtest/ (kept apart from local runs)
RESULTS=results-aws
